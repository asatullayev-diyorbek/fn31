# Firebase Web (client) config — these are PUBLIC identifiers, not secrets.
# They identify which Firebase project the app talks to; access control is
# enforced by Firestore/Storage Security Rules and Firebase App Check, not
# by hiding these values. Safe to ship in the browser bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# reCAPTCHA Enterprise site key used by Firebase App Check in production.
# Public by design (App Check security comes from the paired secret key
# held by Google, not from hiding this value).
VITE_APP_CHECK_SITE_KEY=

# Telegram bot *username* only (public, used to build the deep link).
# The BOT TOKEN is never put here — it lives only in Cloud Functions config
# / Secret Manager. See docs/telegram-auth.md.
VITE_TELEGRAM_BOT_USERNAME=

# Set to "true" to use the local Firebase Emulator Suite instead of a real
# Firebase project. See docs/deployment.md.
VITE_USE_FIREBASE_EMULATORS=true
